# Copy to .env.local and fill in. README › Set up Sanity.

# Your Sanity project (sanity.io/manage). Public: these two reach the browser, nothing else does.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server only. A Viewer token: lets the preview (draft mode) read drafts.
SANITY_API_READ_TOKEN=
# Only for `pnpm seed`: an Editor token. Delete it from this file once the demo content is in.
SANITY_API_WRITE_TOKEN=
# The secret of the publish webhook (README › Publish without waiting).
SANITY_REVALIDATE_SECRET=
# Your deployed Studio (https://<name>.sanity.studio): the only site allowed to show this one in a frame (Presentation).
SANITY_STUDIO_URL=http://localhost:3333

# The address the site lives at (canonical links, sitemap, feed, Open Graph images).
SITE_URL=https://www.example.com

# Where the newsletter form sends each submission, as JSON (a CRM, a chat webhook, an email API).
# Without it the form answers 503 and accepts nothing.
FORWARD_URL=
